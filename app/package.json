{
  "name": "2d6-companion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --host",
    "copy-dice": "node scripts/copy-dice.mjs",
    "copy-vendor": "node scripts/copy-vendor.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "predev": "npm run copy-dice && npm run build-icons && npm run copy-vendor",
    "prebuild": "npm run copy-dice && npm run build-icons && npm run copy-vendor",
    "test": "vitest run",
    "locator": "tsx scripts/locator/build.ts",
    "desktop": "npm run build && electron .",
    "desktop:run": "electron .",
    "dist:win": "npm run build && node scripts/check-dist.mjs --require-phrases && electron-builder --win",
    "release:win": "npm run build && node scripts/check-dist.mjs --require-phrases && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@3d-dice/dice-themes": "^0.2.1",
    "@babylonjs/core": "5.57.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^0.1.65",
    "@noble/hashes": "^2.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "lucide-static": "^1.71.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "electron-updater": "^6.8.11"
  },
  "main": "electron/main.cjs",
  "description": "A private, local reference and play companion for 2D6 Dungeon and 2D6 Void",
  "author": "Sean Crawford",
  "build": {
    "appId": "com.local.2d6companion",
    "productName": "2D6 Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "2D6-Companion-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "2D6-Companion-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Fizbane",
      "repo": "Unofficial-2D6-Digital-Companion",
      "releaseType": "draft"
    }
  },
  "productName": "2D6 Companion",
  "license": "MIT"
}
